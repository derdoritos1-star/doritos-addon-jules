{
  "schemaVersion": 1,
  "id": "doritos-addon",
  "version": "${version}",
  "name": "doritos addon",
  "description": "the best meteor addon.",
  "authors": [
    "seasnail"
  ],
  "contact": {
    "sources": "https://github.com/MeteorDevelopment/meteor-addon-template"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
  "meteor": [
    "com.example.addon.DoritosAddon"
  ]
},
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
